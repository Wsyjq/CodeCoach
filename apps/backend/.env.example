CODECOACH_ENV=development
CODECOACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODECOACH_ALLOWED_HOSTS=
CODECOACH_AUTH_REQUIRED=true
CODECOACH_BASIC_AUTH_USERNAME=
CODECOACH_BASIC_AUTH_PASSWORD=
CODECOACH_STATIC_DIR=
CODECOACH_DATABASE_PATH=
CODECOACH_VECTORSTORE_DIR=
CODECOACH_ENABLE_DOCS=true
CODECOACH_EXPOSE_TRACES=true
CODECOACH_MAINTENANCE_MODE=false
CODECOACH_MAINTENANCE_MESSAGE=CodeCoach 正在维护升级，服务暂时不可用。请稍后再试。
CODECOACH_USE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_FAILURE_COOLDOWN_SECONDS=0
CODECOACH_LLM_TRACE_AGENTS=false
